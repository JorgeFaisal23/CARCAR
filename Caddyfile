# ==============================================================================
# Configuración de Reverse Proxy Caddy con TLS Automático y Cabeceras de Seguridad
# ==============================================================================

{$DOMAIN:localhost} {
    # Compresión automática zstd y gzip
    encode zstd gzip

    # Cabeceras de Seguridad para Blindaje Web
    header {
        # Protección contra ataques de Clickjacking
        X-Frame-Options "DENY"
        # Prevención de sniffing de tipo MIME
        X-Content-Type-Options "nosniff"
        # Protección XSS para navegadores legados
        X-XSS-Protection "1; mode=block"
        # Política de Referrer estricta
        Referrer-Policy "strict-origin-when-cross-origin"
        # Política de permisos restringida
        Permissions-Policy "camera=(self), microphone=(), geolocation=(), payment=()"
        # HSTS (Strict Transport Security) para forzar HTTPS por 1 año
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        # Ocultar cabecera del servidor para evitar fingerprinting
        -Server
    }

    # Redirección de tráfico hacia el contenedor de Next.js
    reverse_proxy web:3000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    # Registro de accesos estructurado en JSON
    log {
        output stdout
        format json
    }
}
