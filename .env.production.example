# ==============================================================================
# Variables de Entorno de Producción para Despliegue en VPS
# ==============================================================================
# Copia este archivo a `.env` en tu VPS y define valores seguros.
# NUNCA compartas este archivo ni lo subas al repositorio.

# Dominio público para Caddy y certificados SSL automáticos (ej. app.rentacore.mx o rentas.carcar.com)
DOMAIN=tu-dominio.com

# Credenciales de la Base de Datos PostgreSQL (Contenedor interno)
POSTGRES_USER=rentacore_admin
POSTGRES_PASSWORD=genera_una_contrasena_aleatoria_muy_fuerte_aqui
POSTGRES_DB=rentacore_prod

# Secreto criptográfico para la firma de sesiones JWT (Generar con: openssl rand -base64 32)
AUTH_SECRET=genera_un_token_secreto_con_openssl_aqui

# Credenciales iniciales para el usuario Administrador / OWNER de CARCAR (Opcional, por defecto usa admin@carcar.mx / carcar2026!)
# CARCAR_OWNER_EMAIL=admin@carcar.mx
# CARCAR_OWNER_PASSWORD=tu_contrasena_segura_aqui
